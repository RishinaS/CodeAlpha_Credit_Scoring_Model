# Credit Intelligence Backend — Environment Configuration
# Copy this file to .env and customize as needed

APP_NAME=Credit Intelligence
APP_VERSION=1.0.0
DEBUG=false

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database — SQLite by default, replace with PostgreSQL URL for production
DATABASE_URL=sqlite:///./credit_intelligence.db

# Models directory path (relative to backend/)
MODELS_DIR=../models

LOG_LEVEL=INFO
